# Copy this file to `.env` and replace the placeholders with your own keys.
# Never commit `.env` - it is listed in .gitignore.

# NVIDIA Build API key. Powers the Nemotron model used to classify offers
# (Shop & Compare) and to verify product images (Single product).
# Get one at https://build.nvidia.com
NVIDIA_API_KEY=your-nvidia-build-api-key

# SerpApi key. Powers the Google Shopping search and merchant-link
# resolution (Shop & Compare) and the Google Images fallback (Single product).
# Get one at https://serpapi.com
PIR_SERPAPI_API_KEY=your-serpapi-api-key

# Optional: per-request HTTP timeout in seconds for SerpApi calls.
# The code default is 15; 30 is more forgiving on slow Google Shopping responses.
PIR_REQUEST_TIMEOUT_SECONDS=30
